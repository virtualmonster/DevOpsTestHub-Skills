{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "https://www.hcl-software.com/schema/devops/test/Environment/2026/07",
  "type" : "object",
  "properties" : {
    "note" : {
      "type" : "string"
    },
    "meta" : {
      "type" : "object",
      "additionalProperties" : {
        "type" : "string"
      }
    },
    "includes" : {
      "type" : "array",
      "items" : {
        "format" : "val-uri-reference-environment",
        "type" : "string"
      }
    },
    "defaultUser" : {
      "type" : "string"
    },
    "users" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/definitions/EnvironmentUser"
      }
    },
    "secrets" : {
      "type" : "string"
    },
    "profiles" : {
      "type" : "object",
      "additionalProperties" : {
        "anyOf" : [ {
          "$ref" : "#/definitions/EnvironmentProfile"
        }, {
          "type" : "null"
        } ]
      }
    },
    "vars" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/definitions/VarDef"
      }
    }
  },
  "additionalProperties" : false,
  "definitions" : {
    "EnvironmentProfile" : {
      "oneOf" : [ {
        "title" : "agent",
        "type" : "string"
      }, {
        "type" : "object",
        "properties" : {
          "agent" : {
            "type" : "string"
          },
          "device" : {
            "type" : "string"
          }
        },
        "additionalProperties" : false
      } ]
    },
    "EnvironmentUser" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/definitions/VarDef"
      }
    },
    "VarDef" : {
      "oneOf" : [ {
        "title" : "expr",
        "type" : "string"
      }, {
        "type" : "object",
        "properties" : {
          "enabled" : {
            "format" : "js",
            "type" : "string"
          },
          "note" : {
            "type" : "string"
          },
          "expr" : {
            "type" : "string"
          },
          "type" : {
            "$ref" : "#/definitions/VarType"
          },
          "relative" : {
            "format" : "val-boolean",
            "type" : "string"
          }
        },
        "additionalProperties" : false
      } ]
    },
    "VarType" : {
      "enum" : [ "column", "js", "secret", "val" ]
    }
  }
}